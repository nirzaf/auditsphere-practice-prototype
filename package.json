{
  "name": "auditsphere-visual-prototype",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node tools/generate-requirements-deck.mjs && tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "legacy:build": "py -3 build.py",
    "legacy:check": "node --check app.bundle.js",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 tests/e2e/*.test.ts"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
