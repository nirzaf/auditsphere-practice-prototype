{
  "name": "auditsphere-practice-prototype",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.jsonc --local --port 3000",
    "build": "node tools/generate-requirements-deck.mjs && tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "wrangler dev --config wrangler.jsonc --local --port 3000",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "benchmark:local-api": "tsx tools/benchmark-local-worker-20-users.ts",
    "cloud:seed": "tsx tools/seed-cloud-workspace.ts",
    "migration:audit": "tsx tools/business-migration-audit.ts",
    "cloud:typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "cloud:migrate": "wrangler d1 migrations apply steaudit-prototype-demo --remote --config wrangler.jsonc",
    "cloud:r2-archive-locks:generate": "tsx tools/generate-r2-archive-lock-rules.ts",
    "cloud:r2-archive-locks:apply": "npm run cloud:r2-archive-locks:generate && tsx tools/apply-r2-archive-lock-rules.ts",
    "cloud:dev": "npm run dev",
    "cloud:deploy": "npm run build && npm run cloud:r2-archive-locks:apply && wrangler deploy --config wrangler.jsonc",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "cf": "wrangler"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "docx": "^9.7.1",
    "fflate": "0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
