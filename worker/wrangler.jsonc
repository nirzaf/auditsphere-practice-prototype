{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "steaudit-prototype-demo-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "steaudit-prototype-demo", "database_id": "3562b9c7-742b-4a64-b250-64e1987f9b4b", "migrations_dir": "migrations" }],
  "vars": { "ALLOWED_ORIGINS": "https://prototype.steaudit.com,https://steaudit-prototype.pages.dev,http://localhost:3000,http://127.0.0.1:3007,http://localhost:3007" },
  "triggers": { "crons": ["0 2 * * *"] }
}
