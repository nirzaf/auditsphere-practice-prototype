// STE Audit Management Tool — production schema (PostgreSQL 16+).
// Domain authority: Functional Requirements & Workflow Specification v2.1.
// Money is Decimal(18,2) in the engagement currency (QAR primary).
// Row-Level Security policies are applied by prisma/rls/policies.sql after migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum RoleKey {
  PREPARER
  REVIEWER
  APPROVER
  CLIENT
  ADMIN
}

enum EngagementState {
  LEAD_INGESTION
  PROPOSAL_GENERATION
  DUAL_KEY_PENDING
  ADVANCE_BILLING
  PORTAL_ACTIVE_PLANNING
  FIELDWORK_EXECUTION
  MANAGERIAL_REVIEW
  PARTNER_APPROVAL
  DELIVERABLE_RELEASE
  COMPLIANCE_COUNTDOWN
  ARCHIVED_READ_ONLY
}

enum LifecycleStatus {
  Active
  Suspended
  Cancelled
}

enum LeadChannel {
  PHONE
  WHATSAPP
  EMAIL
  WEB_FORM
  REFERRAL
  IN_PERSON
}

enum LeadStage {
  INQUIRY
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ClientRelationship {
  HOLDING
  SUBSIDIARY
  AFFILIATE
  STANDALONE
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ContactRoutingRole {
  MANAGING_DIRECTOR
  CFO
  AUDIT_LIAISON
  OTHER
}

enum ProposalMode {
  BRIEF_QUOTATION
  COMPREHENSIVE_TECHNICAL
}

enum ProposalState {
  DRAFT
  INTERNAL_REVIEW
  APPROVED_TO_SEND
  PRESENTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum AcceptanceTrack {
  TRACK_A_NEW_CLIENT
  TRACK_B_RECURRING_CLIENT
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

enum MaterialityBenchmark {
  PROFIT_BEFORE_TAX
  REVENUE
  TOTAL_ASSETS
  EQUITY
}

enum StatementSection {
  PROFIT_AND_LOSS
  BALANCE_SHEET
}

enum ChargeOutRole {
  PARTNER
  MANAGER
  SENIOR
  JUNIOR
}

enum EngagementPhase {
  PLANNING
  FIELDWORK
  REVIEW
  REPORTING
  COMPLETION
}

enum ProcedureStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REWORK
  CLEARED
}

enum EvidenceKind {
  DIGITAL
  PHYSICAL
}

enum SamplingMethod {
  MONETARY_UNIT
  SYSTEMATIC_RANDOM
  STRATIFIED_ATTRIBUTE
}

enum ConfirmationType {
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  LEGAL
}

enum ConfirmationStatus {
  DRAFT
  REQUESTED
  AWAITING
  RECEIVED
  REVIEWED
  CLEARED
  NO_RESPONSE
  EXCEPTION
  CANCELLED
}

enum ReviewNoteStatus {
  OPEN
  RESPONDED
  CLEARED
  REOPENED
}

enum PbcStatus {
  PENDING_UPLOAD
  UNDER_REVIEW
  APPROVED
  REJECTED_REUPLOAD
}

enum OpinionValue {
  CLEAN
  QUALIFIED
  DISCLAIMER
  ADVERSE
}

enum DocumentCategory {
  PROPOSAL
  ENGAGEMENT_LETTER
  ADVANCE_INVOICE
  OFFICIAL_RECEIPT
  FINAL_BALANCE_INVOICE
  TRIAL_BALANCE
  WORKING_PAPER
  CONFIRMATION
  HOLDING_LETTER
  MANAGEMENT_LETTER
  LETTER_OF_REPRESENTATION
  AUDIT_REPORT
  CORRESPONDENCE
  PBC_EVIDENCE
}

enum DeliverablePart {
  AUDIT_REPORT_AND_FINANCIALS
  MANAGEMENT_LETTER
  LETTER_OF_REPRESENTATION
  MANAGEMENT_CORRESPONDENCE_TRAIL
  FINAL_BALANCE_FEE_NOTE
}

enum FirmAccount {
  CASH
  OFFICE_RENT
  STAFF_SALARIES
  STAFF_BENEFITS
  PARTNER_WITHDRAWALS
  PETTY_CASH
  OTHER_EXPENSES
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

// ─────────────────────────── Identity & access ───────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  /// Stable natural-person key; role-labelled personas of one person share it.
  personId  String
  role      RoleKey
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  accessGrants       ClientAccessGrant[]
  preparedProcedures AuditProcedure[]    @relation("ProcedureAssignee")
  raisedNotes        ReviewNote[]        @relation("ReviewNoteAuthor")
  reviewedNotes      ReviewNote[]        @relation("ReviewNoteClearer")
  timeEntries        TimeEntry[]
  auditEntries       AuditTrailEntry[]

  @@index([role])
  @@index([personId])
}

/// Horizontal authorization: which clients/engagements a user may touch, and how.
model ClientAccessGrant {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Exactly one of clientId / engagementId is set.
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId    String?
  engagement      Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  /// READ | WRITE | REVIEW | APPROVE | CLIENT_PORTAL
  accessKind      String
  grantedByUserId String
  grantedAt       DateTime    @default(now())
  revokedAt       DateTime?

  @@index([userId, clientId])
  @@index([userId, engagementId])
}

// ─────────────────────────── Module 1: Commercial & CRM ───────────────────────────

model Lead {
  id                String      @id @default(cuid())
  channel           LeadChannel
  companyName       String
  contactName       String
  contactEmail      String
  contactPhone      String?
  notes             String?
  stage             LeadStage   @default(INQUIRY)
  capturedByUserId  String
  capturedAt        DateTime    @default(now())
  convertedClientId String?
  convertedClient   Client?     @relation("ConvertedLead", fields: [convertedClientId], references: [id])
  proposals         Proposal[]

  @@index([stage])
}

model Client {
  id              String             @id @default(cuid())
  legalName       String
  legalNameArabic String?
  /// Qatar Commercial Registration number.
  crNumber        String?
  /// Qatar Tax Identification Number.
  tin             String?
  country         String             @default("QA")
  relationship    ClientRelationship @default(STANDALONE)
  parentClientId  String?
  parentClient    Client?            @relation("ClientGroup", fields: [parentClientId], references: [id])
  subsidiaries    Client[]           @relation("ClientGroup")
  status          ClientStatus       @default(PROSPECT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?

  contacts       ClientContact[]
  proposals      Proposal[]
  engagements    Engagement[]
  accessGrants   ClientAccessGrant[]
  documents      Document[]
  portalInvites  PortalInvitation[]
  portalRequests PbcRequest[]
  convertedLeads Lead[]           @relation("ConvertedLead")

  @@index([status])
  @@index([parentClientId])
}

model ClientContact {
  id          String              @id @default(cuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  title       String?
  /// Routes proposals, invoices, receipts and PBC requests (§4.1.1).
  routingRole ContactRoutingRole
  isPrimary   Boolean             @default(false)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  portalInvites PortalInvitation[]
  pbcRequests   PbcRequest[]

  @@index([clientId, active])
}

model Proposal {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  mode            ProposalMode
  revision        Int           @default(1)
  title           String
  scope           String
  exclusions      String?
  reportingYear   Int
  currency        String        @default("QAR")
  totalFee        Decimal       @db.Decimal(18, 2)
  /// Fixed 50/50 institutional terms (§4.1.2).
  paymentTerms    String        @default("50/50")
  timeline        String?
  state           ProposalState @default(DRAFT)
  dispatchedVia   String?
  dispatchedAt    DateTime?
  acceptedRevision            Int?
  clientAcceptanceEvidenceRef String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lineItems    ProposalLineItem[]
  dualKeyGates DualKeyGate[]

  @@index([clientId, state])
}

model ProposalLineItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  sortOrder   Int      @default(0)

  @@index([proposalId])
}

/// Spec §4.1.3 — the Dual-Key onboarding gatekeeper, one row per engagement.
model DualKeyGate {
  id           String     @id @default(cuid())
  engagementId String     @unique
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  proposalId   String?
  proposal     Proposal?  @relation(fields: [proposalId], references: [id])

  // Key 1 — Client commercial approval of a specific proposal revision.
  key1Approved         Boolean   @default(false)
  key1ProposalRevision Int?
  key1EvidenceRef      String?
  key1RecordedByUserId String?
  key1RecordedAt       DateTime?

  // Key 2 — Engagement Partner AML/KYC risk clearance (ISA 220).
  key2Approved         Boolean   @default(false)
  key2Decision         String    @default("Pending")
  key2DecisionByUserId String?
  key2DecisionAt       DateTime?
  key2DecisionNotes    String?

  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Engagement core ───────────────────────────

model Engagement {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  proposalId      String?
  service         String
  reportingYear   Int
  periodStart     DateTime
  periodEnd       DateTime
  currency        String          @default("QAR")
  agreedFee       Decimal         @db.Decimal(18, 2)
  letterTemplate  String
  /// Canonical 11-stage lifecycle (spec §5). Only the state machine may change it.
  state           EngagementState @default(LEAD_INGESTION)
  lifecycleStatus LifecycleStatus @default(Active)

  partnerUserId   String
  managerUserId   String
  reviewerUserId  String?
  /** Preparer user ids assigned to this engagement. */
  preparerUserIds String[]        @default([])

  targetFieldworkStart DateTime?
  targetDraftReport   DateTime?
  targetFinalReport   DateTime?

  // Dual-Key + billing facts mirrored for fast state-machine evaluation.
  advanceRequiredQar Decimal? @db.Decimal(18, 2)
  advanceRecordedQar Decimal  @db.Decimal(18, 2) @default(0)
  advanceReceiptDocumentId String?

  // Archive control (ISA 230).
  signatureDate    DateTime?
  freezeDueDate    DateTime?
  freezeStatus     String     @default("Not Started")
  frozenAt         DateTime?
  frozenByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accessGrants       ClientAccessGrant[]
  dualKeyGate        DualKeyGate?
  acceptance         AcceptanceScreening?
  materiality        MaterialityRevision[]
  staffing           StaffAllocation[]
  folders            EngagementFolder[]
  trialBalanceRows   TrialBalanceRow[]
  fsliItems          Fsli[]
  workPrograms       WorkProgram[]
  samplePlans        SamplePlan[]
  analyticalReviews  AnalyticalReview[]
  reviewNotes        ReviewNote[]
  confirmations      Confirmation[]
  holdingLetters     HoldingLetter[]
  srmRecords         SrmRecord[]
  opinionSelections  OpinionSelection[]
  deliverableSets    DeliverableSet[]
  documents          Document[]
  pbcRequests        PbcRequest[]
  timeEntries        TimeEntry[]
  stateTransitions   EngagementStateTransition[]
  auditTrail         AuditTrailEntry[]
  archive            ArchiveRecord?

  @@index([clientId, state])
  @@index([state])
  @@index([partnerUserId])
  @@index([managerUserId])
}

/// Immutable log of state-machine edges (append-only; never updated or deleted).
model EngagementStateTransition {
  id           String          @id @default(cuid())
  engagementId String
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  event        String
  fromState    EngagementState
  toState      EngagementState
  actorUserId  String
  actorRole    RoleKey
  note         String?
  at           DateTime        @default(now())

  @@index([engagementId, at])
}

/// Tamper-evident audit trail with a per-engagement SHA-256 hash chain.
model AuditTrailEntry {
  id           String   @id @default(cuid())
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String
  entityId     String
  fromState    String?
  toState      String?
  detail       String?
  previousHash String?
  hash         String
  at           DateTime @default(now())

  @@index([engagementId, at])
  @@index([entityType, entityId])
}

// ─────────────────────────── Module 2: Governance & planning ───────────────────────────

/// ISA 220 / ISQC 1 acceptance & continuance screening (Track A / Track B).
model AcceptanceScreening {
  id           String          @id @default(cuid())
  engagementId String          @unique
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  track        AcceptanceTrack

  uboCompleted                 Boolean @default(false)
  amlKycCompleted              Boolean @default(false)
  kycDocsRef                   String?
  managementIntegrityAssessed  Boolean @default(false)
  financialViabilityAssessed   Boolean @default(false)
  independenceConfirmed        Boolean @default(false)
  conflictsCleared             Boolean @default(false)

  // Track B recurring-client deltas.
  priorYearFeesSettled  Boolean?
  managementChangesNoted Boolean?
  newCreditFacilities    Boolean?
  litigationFlags        Boolean?
  fraudOrRegulatoryFindings Boolean?

  riskRating RiskRating
  conditions String[]   @default([])

  recommendedByUserId String
  recommendedAt       DateTime @default(now())
  recommendationNotes String

  decision         String    @default("Pending")
  decisionByUserId String?
  decisionAt       DateTime?
  decisionNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ISA 320 planning materiality per revision; manually rounded values keep the audit trail.
model MaterialityRevision {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  revision     Int

  benchmark      MaterialityBenchmark
  benchmarkValue Decimal              @db.Decimal(18, 2)
  materialityRate Decimal             @db.Decimal(5, 2)
  planningMateriality Decimal         @db.Decimal(18, 2)
  tolerableErrorRate  Decimal         @db.Decimal(5, 2)
  tolerableError      Decimal         @db.Decimal(18, 2)
  sadRate             Decimal         @db.Decimal(5, 2)
  sadThreshold        Decimal         @db.Decimal(18, 2)

  // Practical rounding (±5% max) with Partner sign-off.
  roundingApplied      Boolean  @default(false)
  computedPm           Decimal? @db.Decimal(18, 2)
  computedTe           Decimal? @db.Decimal(18, 2)
  roundingVariancePct  Decimal? @db.Decimal(5, 2)
  roundingSignOffUserId String?
  roundingSignOffAt     DateTime?

  rationale String

  reviewedByUserId String?
  reviewedAt       DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  supersededByRevision Int?

  createdAt DateTime @default(now())

  @@unique([engagementId, revision])
  @@index([engagementId])
}

model StaffAllocation {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       String
  chargeOutRole ChargeOutRole
  phase        EngagementPhase
  plannedHours Decimal  @db.Decimal(8, 2)
  startDate    DateTime
  endDate      DateTime
  revision     Int      @default(1)
  assignedByUserId String
  assignedAt   DateTime @default(now())

  @@index([engagementId, phase])
  @@index([userId])
}

/// Standard five-folder taxonomy provisioned per engagement (§4.2.3).
model EngagementFolder {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  folderKey    String
  displayName  String
  storagePath  String
  provisionedAt DateTime @default(now())

  @@unique([engagementId, folderKey])
}

// ─────────────────────────── Module 3: Technical execution & fieldwork ───────────────────────────

model TrialBalanceRow {
  id             String           @id @default(cuid())
  engagementId   String
  engagement     Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  sourceRevision Int
  accountCode    String
  accountName    String
  section        StatementSection
  fsliId         String?
  fsli           Fsli?            @relation(fields: [fsliId], references: [id])
  currentYear    Decimal          @db.Decimal(18, 2)
  priorYear      Decimal          @db.Decimal(18, 2) @default(0)
  /// Mapping memory: how this account was mapped in prior revisions.
  mappingSource  String?

  @@index([engagementId, sourceRevision])
  @@index([accountCode])
}

model Fsli {
  id           String          @id @default(cuid())
  engagementId String
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  code         String
  label        String
  section      StatementSection
  currentYear  Decimal         @db.Decimal(18, 2) @default(0)
  priorYear    Decimal         @db.Decimal(18, 2) @default(0)
  /// Cached strata result (§4.2.4); recomputed whenever materiality changes.
  riskStratum  String?
  riskReason   String?
  /// Row-level checkout lock to prevent concurrent auditor collision.
  lockedByUserId String?
  lockedAt       DateTime?

  tbRows             TrialBalanceRow[]
  workPrograms       WorkProgram[]
  samplePlans        SamplePlan[]
  analyticalReviews  AnalyticalReview[]

  @@unique([engagementId, code])
  @@index([engagementId])
}

model WorkProgram {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  fsliId       String
  fsli         Fsli       @relation(fields: [fsliId], references: [id], onDelete: Cascade)
  title        String
  createdAt    DateTime   @default(now())

  procedures AuditProcedure[]

  @@unique([engagementId, fsliId])
}

model AuditProcedure {
  id               String          @id @default(cuid())
  workProgramId    String
  workProgram      WorkProgram     @relation(fields: [workProgramId], references: [id], onDelete: Cascade)
  ref              String
  title            String
  instructions     String
  assertions       String[]        @default([])
  adHoc            Boolean         @default(false)
  adHocReason      String?
  assignedToUserId String?
  assignee         User?           @relation("ProcedureAssignee", fields: [assignedToUserId], references: [id])
  status           ProcedureStatus @default(NOT_STARTED)
  workPerformed    String?
  conclusion       String?
  submittedByUserId String?
  submittedAt      DateTime?
  clearedByUserId  String?
  clearedAt        DateTime?
  sortOrder        Int             @default(0)

  evidence    EvidenceRef[]
  reviewNotes ReviewNote[]

  @@index([workProgramId, sortOrder])
}

/// Hybrid evidence link: a digital document or a physical binder index (§4.3.2).
model EvidenceRef {
  id             String         @id @default(cuid())
  procedureId    String
  procedure      AuditProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  kind           EvidenceKind
  documentId     String?
  document       Document?      @relation(fields: [documentId], references: [id])
  /// Physical binder tracking: e.g. { indexCode: "X-1", box: "Box 3", shelf: "Shelf B" }.
  physicalIndex  String?
  physicalBox    String?
  physicalShelf  String?
  description    String
  linkedByUserId String
  linkedAt       DateTime       @default(now())

  @@index([procedureId])
}

model SamplePlan {
  id              String         @id @default(cuid())
  engagementId    String
  engagement      Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  fsliId          String
  fsli            Fsli           @relation(fields: [fsliId], references: [id], onDelete: Cascade)
  method          SamplingMethod
  seed            Int
  sampleSize      Int
  populationCount Int
  populationValue Decimal        @db.Decimal(18, 2)
  /// Selected item ids (distinct).
  selectedItemIds String[]       @default([])
  /// Item id -> hit count (MUS may hit an item more than once).
  hits            Json           @default("{}")
  parameters      Json           @default("{}")
  createdByUserId String
  createdAt       DateTime       @default(now())

  @@index([engagementId, fsliId])
}

model AnalyticalReview {
  id              String     @id @default(cuid())
  engagementId    String
  engagement      Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  fsliId          String
  fsli            Fsli       @relation(fields: [fsliId], references: [id], onDelete: Cascade)
  currentBalance  Decimal    @db.Decimal(18, 2)
  priorBalance    Decimal    @db.Decimal(18, 2)
  varianceAmount  Decimal    @db.Decimal(18, 2)
  variancePct     Decimal?   @db.Decimal(9, 2)
  commentary      String
  // ISA 570 going-concern assessment (mandatory for sensitive areas).
  goingConcernAssessed     Boolean  @default(false)
  goingConcernIndicators   Boolean  @default(false)
  goingConcernConclusion   String?
  goingConcernEvidenceRefs String[] @default([])
  preparedByUserId String
  preparedAt       DateTime @default(now())

  @@index([engagementId, fsliId])
}

model ReviewNote {
  id                  String           @id @default(cuid())
  engagementId        String
  engagement          Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  procedureId         String
  procedure           AuditProcedure   @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  raisedAgainstUserId String
  raisedByUserId      String
  raisedBy            User             @relation("ReviewNoteAuthor", fields: [raisedByUserId], references: [id])
  raisedAt            DateTime         @default(now())
  /// Mandatory rejection / rework reason (§4.3.3).
  text                String
  status              ReviewNoteStatus @default(OPEN)
  responseText        String?
  respondedAt         DateTime?
  clearedByUserId     String?
  clearedBy           User?            @relation("ReviewNoteClearer", fields: [clearedByUserId], references: [id])
  clearedAt           DateTime?

  @@index([engagementId, status])
  @@index([procedureId])
}

model Confirmation {
  id           String             @id @default(cuid())
  engagementId String
  engagement   Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  type         ConfirmationType
  counterparty String
  relatedFsliId String?
  status       ConfirmationStatus @default(DRAFT)
  /// Critical confirmations block final report release (§4.3.4).
  critical     Boolean            @default(false)
  requestedAt  DateTime?
  dueAt        DateTime
  receivedAt   DateTime?
  responseDocumentId String?
  responseDocument   Document?    @relation(fields: [responseDocumentId], references: [id])
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([engagementId, status])
}

model HoldingLetter {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  generatedAt  DateTime   @default(now())
  generatedByUserId String
  /// Confirmation ids that were still outstanding when the letter was issued.
  blockingConfirmationIds String[] @default([])
  recipientContactId String?
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id])

  @@index([engagementId])
}

/// Summary Review Memorandum (SRM) — §4.3.3.
model SrmRecord {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  revision     Int
  compiledByUserId String
  compiledAt   DateTime   @default(now())
  /// Unadjusted differences vs SAD / PM.
  unadjustedDifferences Json   @default("[]")
  totalUnadjusted       Decimal @db.Decimal(18, 2) @default(0)
  /// Adjustment journals proposed but not recorded in the financial statements.
  ajes                  Json   @default("[]")
  openRedRisks          Json   @default("[]")
  significantEstimates  Json   @default("[]")
  recommendation        String
  /// Cleared by the Engagement Partner after Red-risk inspection.
  partnerClearedByUserId String?
  partnerClearedAt       DateTime?
  partnerClearanceNotes  String?

  @@unique([engagementId, revision])
}

// ─────────────────────────── Module 4: Reporting & deliverables ───────────────────────────

/// ISA 700 / ISA 705 opinion selection with the conditional qualification builder.
model OpinionSelection {
  id           String       @id @default(cuid())
  engagementId String
  engagement   Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  revision     Int          @default(1)
  opinion      OpinionValue
  /// Affected FSLIs; required for Qualified / Disclaimer / Adverse.
  affectedFsliIds String[]  @default([])
  /// Injected into the "Basis for Qualified/Modified Opinion" paragraph.
  basisRationale String
  selectedByUserId String
  selectedAt     DateTime   @default(now())
  reportDate     DateTime
  /// Partner digital signature + firm seal applied to the certified PDF.
  signatureApplied   Boolean @default(false)
  signatureAppliedAt DateTime?
  sealAssetKey       String?
  signatureAssetKey  String?

  deliverableSets DeliverableSet[]

  @@unique([engagementId, revision])
}

model DeliverableSet {
  id                 String     @id @default(cuid())
  engagementId       String
  engagement         Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  revision           Int        @default(1)
  opinionSelectionId String
  opinionSelection   OpinionSelection @relation(fields: [opinionSelectionId], references: [id])
  generatedByUserId  String
  generatedAt        DateTime   @default(now())
  deliveredAt        DateTime?
  deliveredToContactId String?
  deliveryNotes      String?

  artifacts DeliverableArtifact[]

  @@unique([engagementId, revision])
}

model DeliverableArtifact {
  id            String         @id @default(cuid())
  deliverableId String
  deliverables  DeliverableSet @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  part          DeliverablePart
  documentId    String
  document      Document       @relation(fields: [documentId], references: [id])
  sha256        String

  @@unique([deliverableId, part])
}

/// ISA 230 regulatory archive: 60-day countdown, then immutable read-only.
model ArchiveRecord {
  id           String     @id @default(cuid())
  engagementId String     @unique
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  signatureDate DateTime
  freezeDueDate DateTime
  frozenAt      DateTime?
  frozenByUserId String?
  mode          String     @default("Automatic")
  manifestHash  String?
  createdAt     DateTime   @default(now())
}

// ─────────────────────────── Module 5: Practice management ───────────────────────────

model TimeEntry {
  id           String          @id @default(cuid())
  engagementId String
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  chargeOutRole ChargeOutRole
  date         DateTime
  hours        Decimal         @db.Decimal(6, 2)
  phase        EngagementPhase
  fsliId       String?
  narrative    String
  billable     Boolean         @default(true)
  approved     Boolean         @default(false)
  approvedByUserId String?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([engagementId, date])
  @@index([userId, date])
}

model FirmLedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  reference   String   @unique
  createdByUserId String
  createdAt   DateTime @default(now())
  lines       FirmLedgerLineItem[]
}

model FirmLedgerLineItem {
  id        String          @id @default(cuid())
  entryId   String
  entry     FirmLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   FirmAccount
  debit     Decimal         @db.Decimal(18, 2) @default(0)
  credit    Decimal         @db.Decimal(18, 2) @default(0)

  @@index([entryId])
}

// ─────────────────────────── Documents & client portal ───────────────────────────

/// Storage-abstracted document metadata (SharePoint/Graph, S3 or local driver).
model Document {
  id           String           @id @default(cuid())
  category     DocumentCategory
  clientId     String?
  client       Client?          @relation(fields: [clientId], references: [id])
  engagementId String?
  engagement   Engagement?      @relation(fields: [engagementId], references: [id])
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String
  createdByUserId String
  createdAt    DateTime         @default(now())
  supersedesDocumentId String?
  /// Frozen archive copies (ISA 230) are marked read-only.
  readOnly     Boolean          @default(false)

  evidenceRefs        EvidenceRef[]
  confirmationResponses Confirmation[]
  holdingLetters      HoldingLetter[]
  deliverableArtifacts DeliverableArtifact[]
  pbcUploads          PbcUpload[]

  @@index([engagementId, category])
  @@index([clientId, category])
}

/// Tokenized, isolated client access to the PBC portal (§4.1.5).
model PortalInvitation {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId    String
  contact      ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email        String
  /// SHA-256(token + pepper); the raw token is never stored.
  tokenHash    String   @unique
  expiresAt    DateTime
  /// Mandatory password reset on first login before uploads unlock.
  firstLoginResetRequired Boolean @default(true)
  passwordResetAt DateTime?
  lastLoginAt  DateTime?
  revokedAt    DateTime?
  createdByUserId String
  createdAt    DateTime @default(now())

  @@index([clientId, contactId])
}

/// Client PBC request item with the four portal status badges.
model PbcRequest {
  id           String    @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  description  String
  assignedContactId String
  assignedContact   ClientContact @relation(fields: [assignedContactId], references: [id])
  status       PbcStatus @default(PENDING_UPLOAD)
  /// Mandatory auditor reason when a submission is rejected (§4.1.5).
  rejectionReason String?
  rejectedByUserId String?
  rejectedAt   DateTime?
  dueAt        DateTime
  createdByUserId String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?
  approvedByUserId String?

  uploads PbcUpload[]

  @@index([engagementId, status])
  @@index([assignedContactId])
}

model PbcUpload {
  id          String     @id @default(cuid())
  requestId   String
  request     PbcRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id])
  uploadedByContactId String
  uploadedAt  DateTime   @default(now())

  @@index([requestId])
}
