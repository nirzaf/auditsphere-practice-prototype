# --- Database (PostgreSQL 16+) -------------------------------------------------
# Local development uses Prisma Postgres (`npx prisma dev`), which prints its URL.
# Production: application role is NOT a superuser; RLS is enforced for this role.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Migration/seed role: owns the schema and runs DDL + RLS policy files.
DIRECT_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Session / signing ----------------------------------------------------------
SESSION_SECRET="replace-with-32-bytes-of-entropy"
PORTAL_TOKEN_PEPPER="replace-with-an-independent-32-byte-secret"

# --- File storage abstraction (SharePoint/Graph | S3 | local) -------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".storage"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_DRIVE_ID=""
