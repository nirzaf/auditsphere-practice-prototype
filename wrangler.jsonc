// Cloudflare Worker for the AuditSphere prototype.
//
// One Worker serves BOTH the built React/Vite app (Workers Static Assets from
// dist/) and the JSON API under /api/*, same-origin, with D1 for structured
// workspace state and R2 for exact file bytes.
//
// Design note: this uses Wrangler's first-class `assets.directory` static-asset
// support instead of the @cloudflare/vite-plugin. Both produce the same runtime
// shape (one Worker serving assets + API), but this route leaves the existing
// `vite build` output and the Cloudflare Pages deployment byte-for-byte
// unchanged, which keeps deployments low-risk (see
// docs/prototype/cloud-full-stack-migration.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auditsphere-visual-prototype",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steaudit-prototype-demo",
      "database_id": "3562b9c7-742b-4a64-b250-64e1987f9b4b",
      "migrations_dir": "worker/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "auditsphere-prototype-files"
    }
  ],

  "observability": { "enabled": true },

  "triggers": { "crons": ["0 2 * * *"] }
}
