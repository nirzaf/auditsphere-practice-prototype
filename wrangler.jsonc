// AuditSphere app Worker. Environment bindings are deliberately isolated.
// Resource IDs remain placeholders until the firm records data residency (D5).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The base is not a deployment target; scripts and CI select staging/production.
  "name": "auditsphere-config-only",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true },

  "env": {
    "local": {
      "name": "auditsphere-local",
      "workers_dev": false,
      "d1_databases": [{
        "binding": "DB",
        "database_name": "auditsphere-local",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "worker/migrations"
      }],
      "r2_buckets": [{
        "binding": "FILES",
        "bucket_name": "auditsphere-local-files"
      }],
      "vars": {
        "ENVIRONMENT": "local",
        "PUBLIC_LEAD_DEFAULT_COUNTRY_CODE": "QA",
        "PUBLIC_LEAD_ALLOWED_ORIGINS": "",
        "PUBLIC_LEAD_TURNSTILE_HOSTNAMES": ""
      }
    },
    "staging": {
      "name": "auditsphere-staging",
      "workers_dev": false,
      "d1_databases": [{
        "binding": "DB",
        "database_name": "auditsphere-staging",
        "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
        "migrations_dir": "worker/migrations"
      }],
      "r2_buckets": [{
        "binding": "FILES",
        "bucket_name": "auditsphere-staging-files"
      }],
      "ratelimits": [{
        "name": "RATE_LIMITER",
        "namespace_id": "2026101001",
        "simple": { "limit": 1000, "period": 60 }
      }],
      "services": [{
        "binding": "EMAIL_PROVIDER",
        "service": "auditsphere-email-provider",
        "environment": "staging"
      }],
      "vars": {
        "ENVIRONMENT": "staging",
        "SHAREPOINT_TENANT_ID": "4de3e6fd-51aa-4ba7-b2c5-82106d2e45f0",
        "SHAREPOINT_CLIENT_ID": "69eddc6b-194f-411a-9d77-5b96fa1602ad",
        "SHAREPOINT_SITE_HOSTNAME": "easyguide.sharepoint.com",
        "SHAREPOINT_SITE_PATH": "/sites/AuditSphereJSAcceptance",
        "SHAREPOINT_DRIVE_NAME": "Documents",
        "PUBLIC_LEAD_DEFAULT_COUNTRY_CODE": "QA",
        "PUBLIC_LEAD_NOTIFICATION_EMAIL": "testing@mail.steauditing.com",
        "PUBLIC_LEAD_ALLOWED_ORIGINS": "",
        "PUBLIC_LEAD_TURNSTILE_HOSTNAMES": ""
      },
      "triggers": { "crons": ["* * * * *"] }
    },
    "production": {
      "name": "auditsphere",
      "workers_dev": false,
      "d1_databases": [{
        "binding": "DB",
        "database_name": "auditsphere-production",
        "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
        "migrations_dir": "worker/migrations"
      }],
      "r2_buckets": [{
        "binding": "FILES",
        "bucket_name": "auditsphere-production-files"
      }],
      "ratelimits": [{
        "name": "RATE_LIMITER",
        "namespace_id": "2026101002",
        "simple": { "limit": 1000, "period": 60 }
      }],
      "services": [{
        "binding": "EMAIL_PROVIDER",
        "service": "auditsphere-email-provider",
        "environment": "production"
      }],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_LEAD_DEFAULT_COUNTRY_CODE": "QA",
        "PUBLIC_LEAD_NOTIFICATION_EMAIL": "audit@steaudit.com",
        "PUBLIC_LEAD_ALLOWED_ORIGINS": "https://www.steaudit.com",
        "PUBLIC_LEAD_TURNSTILE_HOSTNAMES": "www.steaudit.com"
      },
      "triggers": { "crons": ["* * * * *"] }
      // TODO(D6): add the approved custom-domain route after the firm selects
      // the product hostname and a trusted perimeter. Do not expose workers.dev.
    }
  }
}
